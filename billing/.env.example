# ================================================
# RAZORPAY CONFIGURATION
# ================================================
# Get these from: https://dashboard.razorpay.com/
# 
# For Test Mode (Development):
# 1. Switch to "Test Mode" in Razorpay Dashboard (top-left toggle)
# 2. Go to Settings > API Keys > Generate Test Keys
# 3. Test keys start with "rzp_test_"
#
# For Live Mode (Production):
# 1. Complete KYC verification in Razorpay Dashboard
# 2. Switch to "Live Mode"
# 3. Go to Settings > API Keys > Generate Live Keys
# 4. Live keys start with "rzp_live_"
# ================================================

# Razorpay Key ID (starts with rzp_test_ or rzp_live_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret (for webhook signature verification)
# Get this from: Settings > Webhooks > Add Webhook > Secret
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ================================================
# IMPORTANT NOTES
# ================================================
# 
# 1. NEVER commit actual credentials to version control
# 2. Use test credentials during development
# 3. Switch to live credentials only when ready for production
# 4. Keep webhook secret secure
# 5. Rotate keys if compromised
#
# Moving from Test to Live:
# - Simply replace test keys with live keys
# - No code changes required!
# - Restart the backend server
# 
# Test Credit Cards (Test Mode Only):
# - Success: 4111 1111 1111 1111
# - Failed: 4000 0000 0000 0002
# - Insufficient: 4000 0000 0000 9995
# ================================================
